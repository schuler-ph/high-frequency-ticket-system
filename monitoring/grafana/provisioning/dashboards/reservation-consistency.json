{
  "__inputs": [],
  "__requires": [],
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "calcs": ["mean", "max"],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(reservations_created_total{job=\"api\"}[1m]))",
          "legendFormat": "Reservations Created / s",
          "refId": "A"
        },
        {
          "expr": "sum(rate(publish_rollbacks_total{job=\"api\"}[1m])) or vector(0)",
          "legendFormat": "Publish Rollbacks / s",
          "refId": "B"
        },
        {
          "expr": "sum(rate(worker_compensations_total{job=\"worker\"}[1m])) or vector(0)",
          "legendFormat": "Worker Compensations / s",
          "refId": "C"
        }
      ],
      "title": "Reservation Flow (Created / Rollbacks / Compensations)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "expr": "(sum(increase(publish_rollbacks_total{job=\"api\"}[5m])) or vector(0)) / (sum(increase(reservations_created_total{job=\"api\"}[5m])) > 0)",
          "legendFormat": "Rollback Rate (5m)",
          "refId": "A"
        }
      ],
      "title": "Publish Rollback Rate (5m)",
      "type": "gauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "id": 3,
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "expr": "(sum(increase(worker_compensations_total{job=\"worker\"}[5m])) or vector(0)) / (sum(increase(reservations_created_total{job=\"api\"}[5m])) > 0)",
          "legendFormat": "Compensation Rate (5m)",
          "refId": "A"
        }
      ],
      "title": "Worker Compensation Rate (5m)",
      "type": "gauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Capacity Delta"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "orange",
                  "mode": "fixed"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 3
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "id": 4,
      "options": {
        "legend": {
          "calcs": ["mean", "last", "min", "max"],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "inventory_capacity_delta_tickets{job=\"worker\"}",
          "legendFormat": "Capacity Delta ({{event_id}})",
          "refId": "A"
        }
      ],
      "title": "Capacity Delta over time \u2014 available + sold + active \u2212 capacity",
      "description": "Signed cross-system diagnostic with min/max/last. Positive = more claims than seats; negative = seats missing from the accounting. Transient non-zero samples are possible during concurrent Redis/DB transitions; after a completed drain the value must be exactly 0.",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "short",
          "noValue": "no data"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 16
      },
      "id": 5,
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "expr": "abs(inventory_capacity_delta_tickets{job=\"worker\"})",
          "legendFormat": "|delta| {{event_id}}",
          "refId": "A"
        }
      ],
      "title": "Final Capacity Invariant |delta| (after drain = 0)",
      "type": "gauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 16,
        "x": 8,
        "y": 16
      },
      "id": 6,
      "options": {
        "legend": {
          "calcs": ["mean", "max"],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (event_id) (rate(reservations_created_total{job=\"api\"}[1m]))",
          "legendFormat": "reservations {{event_id}}",
          "refId": "A"
        },
        {
          "expr": "sum by (event_id) (rate(publish_rollbacks_total{job=\"api\"}[1m]))",
          "legendFormat": "rollbacks {{event_id}}",
          "refId": "B"
        }
      ],
      "title": "Reservations & Rollbacks by Event",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "id": 7,
      "options": {
        "legend": {
          "calcs": ["mean", "max"],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "reservation_ledger_active{job=\"worker\"}",
          "legendFormat": "active {{event_id}}",
          "refId": "A"
        },
        {
          "expr": "reservation_ledger_stale{job=\"worker\"}",
          "legendFormat": "due (Reaper-Kandidaten) {{event_id}}",
          "refId": "B"
        }
      ],
      "title": "Reservation Ledger (active / due)",
      "type": "timeseries",
      "description": "Aktive Ansprueche im ZSet-Ledger. due > 0 bedeutet, dass die Eligibility Deadline erreicht ist; nur der Pending-Reaper darf anschliessend konkrete pending-Ansprueche atomar freigeben."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2
          },
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "id": 8,
      "options": {
        "legend": {
          "calcs": ["last", "min", "max"],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "inventory_capacity_tickets{job=\"worker\"}",
          "legendFormat": "capacity {{event_id}}",
          "refId": "A"
        },
        {
          "expr": "inventory_available_tickets{job=\"worker\"}",
          "legendFormat": "available {{event_id}}",
          "refId": "B"
        },
        {
          "expr": "inventory_sold_tickets{job=\"worker\"}",
          "legendFormat": "sold {{event_id}}",
          "refId": "C"
        },
        {
          "expr": "reservation_ledger_active{job=\"worker\"}",
          "legendFormat": "active {{event_id}}",
          "refId": "D"
        }
      ],
      "title": "Inventory Components (capacity / available / sold / active)",
      "description": "Raw operands of the capacity invariant, captured by the same read-only audit cycle.",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2
          },
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 38
      },
      "id": 9,
      "options": {
        "legend": {
          "calcs": ["last", "mean", "max"],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(inventory_audit_duration_seconds_bucket{job=\"worker\"}[5m])))",
          "legendFormat": "audit p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(inventory_audit_duration_seconds_bucket{job=\"worker\"}[5m])))",
          "legendFormat": "audit p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(inventory_audit_duration_seconds_bucket{job=\"worker\"}[5m])))",
          "legendFormat": "audit p99",
          "refId": "C"
        }
      ],
      "title": "Inventory Auditor Duration",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 90
              },
              {
                "color": "red",
                "value": 180
              }
            ]
          },
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 38
      },
      "id": 10,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "time() - inventory_audit_last_success_timestamp_seconds{job=\"worker\"}",
          "legendFormat": "seconds since last success",
          "refId": "A"
        }
      ],
      "title": "Auditor Freshness",
      "description": "Expected below roughly two 60-second inventory cycles. Errors: increase(inventory_audit_runs_total{result=\"error\"}[15m]).",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 30
              }
            ]
          },
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 38
      },
      "id": 11,
      "options": {
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "expr": "reservation_reaper_oldest_age_seconds{job=\"worker\"}",
          "legendFormat": "oldest pending {{event_id}}",
          "refId": "A"
        }
      ],
      "title": "Oldest Pending Reservation (beyond deadline)",
      "description": "Age beyond the eligibility deadline of the oldest pending claim handled in the latest reaper run; 0 means no due pending claim was released.",
      "type": "gauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2
          },
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 46
      },
      "id": 12,
      "options": {
        "legend": {
          "calcs": ["last", "mean", "max"],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "reservation_reaper_candidates{job=\"worker\"}",
          "legendFormat": "candidates {{event_id}}",
          "refId": "A"
        },
        {
          "expr": "sum by (event_id) (rate(reservation_reaper_releases_total{job=\"worker\"}[5m]))",
          "legendFormat": "releases/s {{event_id}}",
          "refId": "B"
        },
        {
          "expr": "sum by (event_id, reason) (rate(reservation_reaper_skips_total{job=\"worker\"}[5m]))",
          "legendFormat": "skips/s {{reason}} {{event_id}}",
          "refId": "C"
        },
        {
          "expr": "sum by (event_id) (rate(reservation_reaper_errors_total{job=\"worker\"}[5m]))",
          "legendFormat": "errors/s {{event_id}}",
          "refId": "D"
        },
        {
          "expr": "increase(inventory_audit_runs_total{job=\"worker\",result=\"error\"}[15m])",
          "legendFormat": "audit errors / 15m",
          "refId": "E"
        }
      ],
      "title": "Reaper Activity & Auditor Errors",
      "type": "timeseries"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["hts", "inventory", "integrity"],
  "templating": {
    "list": [
      {
        "current": {},
