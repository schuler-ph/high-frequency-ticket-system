          "calcs": ["mean", "max"],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "(sum(rate(http_request_duration_seconds_count{job=\"api\", status_code=~\"5..\"}[1m])) or vector(0)) / sum(rate(http_request_duration_seconds_count{job=\"api\"}[1m]))",
          "legendFormat": "5xx Error Rate",
          "refId": "A"
        },
        {
          "expr": "(sum(rate(http_request_duration_seconds_count{job=\"api\", status_code=\"409\"}[1m])) or vector(0)) / sum(rate(http_request_duration_seconds_count{job=\"api\"}[1m]))",
          "legendFormat": "409 Sold Out Rate",
          "refId": "B"
        },
        {
          "expr": "(sum(rate(http_request_duration_seconds_count{job=\"api\", status_code=\"425\"}[1m])) or vector(0)) / sum(rate(http_request_duration_seconds_count{job=\"api\"}[1m]))",
          "legendFormat": "425 Too Early Rate",
          "refId": "C"
        }
      ],
      "title": "Error Rate (5xx / 409 / 425)",
      "type": "timeseries",
      "description": "409 = Sold-Out (buy) bzw. bereits finalisierte Order (pay/cancel); 425 = Sale-Unlock-Gate (ADR-024), im Warm-up sind das alle Kaufversuche."
    },
