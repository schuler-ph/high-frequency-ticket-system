  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "calcs": ["mean", "max"],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(http_request_duration_seconds_count{job=\"api\"}[1m]))",
          "legendFormat": "Total RPS",
          "refId": "A"
        },
        {
          "expr": "sum(rate(http_request_duration_seconds_count{job=\"api\", route=\"/api/tickets/:eventId/buy\"}[1m]))",
          "legendFormat": "POST /buy RPS",
          "refId": "B"
        },
        {
          "expr": "sum(rate(http_request_duration_seconds_count{job=\"api\", route=\"/api/tickets/:eventId/availability\"}[1m]))",
          "legendFormat": "GET /availability RPS",
          "refId": "C"
        },
        {
          "expr": "sum(rate(http_request_duration_seconds_count{job=\"api\", route=\"/api/orders/:orderId/pay\"}[1m])) or vector(0)",
          "legendFormat": "POST /pay RPS",
          "refId": "D"
        },
        {
          "expr": "sum(rate(http_request_duration_seconds_count{job=\"api\", route=\"/api/orders/:orderId/cancel\"}[1m])) or vector(0)",
          "legendFormat": "POST /cancel RPS",
          "refId": "E"
        }
      ],
      "title": "Request Rate (RPS)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "calcs": ["mean", "max"],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"api\", route=\"/api/tickets/:eventId/buy\"}[1m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"api\", route=\"/api/tickets/:eventId/buy\"}[1m])))",
          "legendFormat": "p95",
          "refId": "B"
