{
  "name": "worker",
  "version": "1.0.0",
  "description": "This project was bootstrapped with Fastify-CLI.",
  "type": "module",
  "main": "app.ts",
  "directories": {
    "test": "test"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "node --conditions=source --test \"test/**/*.test.ts\"",
    "test:coverage": "node --conditions=source --test --experimental-test-coverage '--test-coverage-include=src/**' \"test/**/*.test.ts\"",
    "test:ci": "pnpm run test:coverage",
    "start": "turbo run build --filter=worker && fastify start -l info -p 10003 dist/app.js",
    "start:loadtest": "turbo run build --filter=worker && fastify start -l warn -p 10003 dist/app.js",
    "build": "rm -rf dist && tsgo",
    "watch": "tsgo -w",
    "dev": "tsc-watch --onSuccess \"pnpm run dev:start\"",
    "dev:start": "fastify start -P -l info -p 10003 dist/app.js",
    "check-types": "tsgo --noEmit",
    "lint": "eslint . --max-warnings 0",
    "docker:build": "docker build -f Dockerfile -t hts-worker:dev ../..",
    "docker:run": "docker run --rm --name hts-worker --network high-frequency-ticket-system_default -p 10003:10003 -e HTS_ENV_PROFILE -e DATABASE_URL=postgres://postgres:postgres@postgres:5432/high_frequency_tickets -e REDIS_URL=redis://redis:6379 -e PUBSUB_EMULATOR_HOST=pubsub:8085 hts-worker:dev"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/autoload": "^6.0.0",
    "@fastify/redis": "^7.2.0",
    "@fastify/sensible": "^6.0.0",
    "@google-cloud/pubsub": "^5.3.0",
    "@repo/db": "workspace:*",
    "@repo/env": "workspace:*",
    "@repo/types": "workspace:*",
    "drizzle-orm": "^0.45.1",
    "fastify": "^5.0.0",
    "fastify-cli": "^7.4.1",
    "fastify-plugin": "^5.0.0",
    "fastify-type-provider-zod": "^6.1.0",
    "prom-client": "^15.1.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^24.0.8",
    "c8": "^10.1.2",
    "concurrently": "^9.0.0",
    "eslint": "^9.39.1",
    "ioredis": "^5.10.0",
    "tsc-watch": "^6.3.1",
    "typescript": "~5.9.2"
  }
}
