{
  "name": "web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/lib/run-with-profile.mjs --prefix=VITE_ vite",
    "build": "HTS_ENV_PROFILE=${HTS_ENV_PROFILE:-dev} node ../../scripts/lib/run-with-profile.mjs --prefix=VITE_ vite build --emptyOutDir",
    "preview": "node ../../scripts/lib/run-with-profile.mjs --prefix=VITE_ vite preview",
    "lint": "eslint --max-warnings 0",
    "check-types": "tsgo --noEmit"
  },
  "dependencies": {
    "@repo/types": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.39.1",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.2",
    "vite": "^7.1.0"
  }
}
