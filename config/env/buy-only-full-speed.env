# Profil: buy-only-full-speed — nur buy→pay ohne Denkzeit, keine
# Availability-Reads (isoliert den Write-Pfad: Reserve + Publish + Persistenz)
#
# Die drei Lasttest-Profile wiederholen bewusst alle Werte, statt voneinander zu
# erben. Ein Lasttest-Profil muss auf einen Blick vollstaendig lesbar sein: was
# hier nicht steht, gilt nicht. Vererbung waere kuerzer und wuerde genau die
# Frage "welcher Wert galt eigentlich im Lauf?" wieder oeffnen.

NODE_ENV=production
LOG_LEVEL=warn
DISABLE_REQUEST_LOGGING=true

REDIS_URL=redis://localhost:10004
DATABASE_URL=postgres://postgres:postgres@localhost:10006/high_frequency_tickets
GOOGLE_CLOUD_PROJECT=high-frequency-ticket-system
PUBSUB_EMULATOR_HOST=localhost:10005
PUBSUB_TOPIC_BUY_TICKET=buy-ticket
PUBSUB_SUBSCRIPTION_BUY_TICKET=buy-ticket-worker

PUBSUB_FLOW_CONTROL_MAX_MESSAGES=500
DATABASE_POOL_MAX=50
DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000
REDIS_CONNECT_TIMEOUT_MS=5000

CHECKOUT_PENDING_TIMEOUT_SECONDS=900
WORKER_RESERVATION_REAPER_BATCH_SIZE=1000
WORKER_RESERVATION_REAPER_INTERVAL_SECONDS=60
WORKER_INVENTORY_CYCLE_INTERVAL_SECONDS=60
REDIS_FINAL_ORDER_TTL_SECONDS=86400
REDIS_WORKER_PROCESSED_TTL_SECONDS=86400

SEED_CAPACITY=1000000
SALE_OPENS_IN_SECONDS=60

NEXT_PUBLIC_API_URL=http://localhost:10002
NEXT_PUBLIC_EVENT_ID=00000000-0000-4000-8000-000000000000

# --- Lastgenerator (k6) ---
LOAD_PROFILE=buy-only-full-speed
# Wo k6 laeuft: local = dieser Host (co-located), ssh = Generator-PC. Die
# Split-Werte (K6_SSH_HOST, K6_REMOTE_DIR, K6_REST_URL, BASE_URL mit LAN-IP)
# kommen inline mit dem Startbefehl — Heimnetz-IPs nicht ins Repo (RUNBOOK §4).
K6_RUNNER=local
BASE_URL=http://localhost:10002
EVENT_ID=00000000-0000-4000-8000-000000000000

# Lastform (ADR-034: explizit, kein Skript-Default). Phase A rampt in 45 s von
# 1.000 auf K6_TARGET_RATE it/s und haelt sie bis zum Sold-out; das VU-Budget
# muss Rate x Iterationsdauer decken, sonst verwirft k6 Iterationen (dropped)
# und der Lauf ist als Kapazitaetsnachweis ungueltig. Phase B ist der
# Cool-down mit fester Rate. Herleitung: docs/notes/backlogs/baseline-f-valid-runs.md
#
# 5.000 it/s, VUs bewusst NICHT erhoeht: Baseline E bot 7.624 it/s an, das
# Order-Plateau lag bei ~5.300 completed/s — 44 % mehr Angebot, als der
# Write-Pfad liefert. Die 38 % dropped waren Rueckstau (bis 3.760 wartende
# Pool-Acquirer, buy_ticket 173 ms statt 1,5 ms), keine Generator-Schwaeche;
# mehr VUs kaufen nur einen tieferen Backlog. 5.000 ist die Zahl, die Phase 5.6
# als Referenz braucht: „5.000 Orders/s sustained, benchmark: valid".
K6_WARMUP_RATE=1000
K6_TARGET_RATE=5000
K6_MAX_VUS=10000
# Baseline F (2026-08-26) belegte alle 10.000 VUs — nicht wegen der Rate
# (~2.500 rechnerisch), sondern weil die API im Crunch an einem Core hing
# (1,04 Cores) und Connects 15 s lang unbeantwortet blieben. Vorallokation
# aendert daran nichts (Runde 2 im full-speed-Profil); 200 ist der Wert der
# Referenzlaeufe. Kapazitaet bringt erst Phase 5.2 (mehrere API-Prozesse).
K6_PREALLOCATED_VUS=200
K6_COOLDOWN_RATE=1000
K6_COOLDOWN_MAX_VUS=5000

# 100 % Checkout: jede Iteration geht direkt buy→pay, alles wird bezahlt.
CHECKOUT_SHARE=1
PAY_RATE=1
CANCEL_RATE=0

# Keine Denkzeit: misst die rohe Infrastruktur, nicht menschliches Timing.
THINK_TIME_KIND=none
THINK_TIME_MIN=0
THINK_TIME_MAX=0
THINK_TIME_MEAN=0
THINK_TIME_SIGMA=0

CHECKOUT_POLL=false
CHECKOUT_POLL_MAX_ATTEMPTS=10
CHECKOUT_POLL_INTERVAL=1

# --- Orchestrierung und Belegerhebung (scripts/local, scripts/load-test) ---
API_METRICS_URL=http://localhost:10002/metrics
WORKER_METRICS_URL=http://localhost:10003/metrics
PROMETHEUS_URL=http://localhost:10007
GRAFANA_URL=http://localhost:10008
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
GRAFANA_TZ=Europe/Vienna
EXPORT_GRAPHS=true

# Plateau-Erkennung: alle 3 s pollen, nach 3 stagnierenden Polls stoppen.
SPIKE_POLL_INTERVAL_MS=3000
SPIKE_SOLDOUT_CONFIRM_POLLS=3
SPIKE_GRACEFUL_STOP_TIMEOUT_MS=40000

# Prometheus-Remote-Write aus k6 heraus: standardmaessig aus, weil der Report
# seine Zahlen aus den Summaries und den Service-Metriken zieht.
K6_PROMETHEUS_RW=false
K6_PROMETHEUS_RW_SERVER_URL=http://localhost:10007/api/v1/write
