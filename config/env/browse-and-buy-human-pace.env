# Profil: browse-and-buy-human-pace — menschliche Denkzeit gegen ein kurzes
# Checkout-Fenster (Abbrecher, ablaufende Checkouts, 410-Expired; beweist
# exakten Sellout unter realistischem Nutzerverhalten)
#
# Die drei Lasttest-Profile wiederholen bewusst alle Werte, statt voneinander zu
# erben. Ein Lasttest-Profil muss auf einen Blick vollstaendig lesbar sein: was
# hier nicht steht, gilt nicht. Vererbung waere kuerzer und wuerde genau die
# Frage "welcher Wert galt eigentlich im Lauf?" wieder oeffnen.

NODE_ENV=production
LOG_LEVEL=warn
DISABLE_REQUEST_LOGGING=true

REDIS_URL=redis://localhost:10004
DATABASE_URL=postgres://postgres:postgres@localhost:10006/high_frequency_tickets
GOOGLE_CLOUD_PROJECT=high-frequency-ticket-system
PUBSUB_EMULATOR_HOST=localhost:10005
PUBSUB_TOPIC_BUY_TICKET=buy-ticket
PUBSUB_SUBSCRIPTION_BUY_TICKET=buy-ticket-worker

PUBSUB_FLOW_CONTROL_MAX_MESSAGES=500
DATABASE_POOL_MAX=50
REDIS_CONNECT_TIMEOUT_MS=5000

CHECKOUT_PENDING_TIMEOUT_SECONDS=120
WORKER_RESERVATION_REAPER_BATCH_SIZE=5000
WORKER_INVENTORY_CYCLE_INTERVAL_SECONDS=60
REDIS_FINAL_ORDER_TTL_SECONDS=86400
REDIS_WORKER_PROCESSED_TTL_SECONDS=86400

SEED_CAPACITY=100000
SALE_OPENS_IN_SECONDS=60

NEXT_PUBLIC_API_URL=http://localhost:10002
NEXT_PUBLIC_EVENT_ID=00000000-0000-4000-8000-000000000000

# --- Lastgenerator (k6) ---
LOAD_PROFILE=browse-and-buy-human-pace
# Wo k6 laeuft: local = dieser Host (co-located), ssh = Generator-PC. Die
# Split-Werte (K6_SSH_HOST, K6_REMOTE_DIR, K6_REST_URL, BASE_URL mit LAN-IP)
# kommen inline mit dem Startbefehl — Heimnetz-IPs nicht ins Repo (RUNBOOK §4).
K6_RUNNER=local
BASE_URL=http://localhost:10002
EVENT_ID=00000000-0000-4000-8000-000000000000

# 5 % Checkout, 95 % Availability-Reads: gleichzeitige Reservierungen sind
# Checkout-Rate mal Denkzeit und damit VU-teuer; Reads sind VU-billig.
CHECKOUT_SHARE=0.05
PAY_RATE=0.9
CANCEL_RATE=0.05

# Menschliche Denkzeit: truncated Normal um 60 s gegen die 120-s-Deadline —
# SIGMA ist der Stellhebel fuer den Anteil der Zu-spaet-Zahler.
THINK_TIME_KIND=normal
THINK_TIME_MIN=10
THINK_TIME_MAX=180
THINK_TIME_MEAN=60
THINK_TIME_SIGMA=35

CHECKOUT_POLL=false
CHECKOUT_POLL_MAX_ATTEMPTS=10
CHECKOUT_POLL_INTERVAL=1

# --- Orchestrierung und Belegerhebung (scripts/local, scripts/load-test) ---
API_METRICS_URL=http://localhost:10002/metrics
WORKER_METRICS_URL=http://localhost:10003/metrics
PROMETHEUS_URL=http://localhost:10007
GRAFANA_URL=http://localhost:10008
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
GRAFANA_TZ=Europe/Vienna
EXPORT_GRAPHS=true

# Plateau-Erkennung: alle 3 s pollen, nach 3 stagnierenden Polls stoppen.
SPIKE_POLL_INTERVAL_MS=3000
SPIKE_SOLDOUT_CONFIRM_POLLS=3
SPIKE_GRACEFUL_STOP_TIMEOUT_MS=40000

# Prometheus-Remote-Write aus k6 heraus: standardmaessig aus, weil der Report
# seine Zahlen aus den Summaries und den Service-Metriken zieht.
K6_PROMETHEUS_RW=false
K6_PROMETHEUS_RW_SERVER_URL=http://localhost:10007/api/v1/write
