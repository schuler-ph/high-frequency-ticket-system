# Profil: cloud-capacity — GKE, scharf: der 50k-Lauf (Modul 8). Dieselben
# sechs Tuning-Werte, die browse-and-buy-full-speed von dev unterscheiden,
# ohne die lokalen Adressen. Der Lauf ist eine Demonstration, keine Baseline
# (REQ-D03/D05 gelten nur lokal).
#
# Zugangsdaten leer (Kubernetes-Secret), Erst-nach-Deploy-Adressen als
# `.invalid` — Erklaerung im Kopf von cloud-dev.env und in ADR-040.
#
# Der k6-Block (Lastform, Anteile, Remote Write) kommt erst in Phase 5.7 dazu,
# wenn Cluster und Generator-VM existieren und die Werte messbar statt geraten
# sind. Er wird dann nicht von API/Worker gelesen, sondern auf der VM per
# `source`; das Zod-Schema ignoriert unbekannte Keys.

NODE_ENV=production
LOG_LEVEL=warn
DISABLE_REQUEST_LOGGING=true

REDIS_URL=
DATABASE_URL=
GOOGLE_CLOUD_PROJECT=replace-me-project-id
PUBSUB_EMULATOR_HOST=
PUBSUB_TOPIC_BUY_TICKET=buy-ticket
PUBSUB_SUBSCRIPTION_BUY_TICKET=buy-ticket-worker

# Flow Control ist DER Durchsatzhebel des Workers in der Cloud (Modul 8) —
# Startwert wie lokal, nach dem ersten Lauf nachziehen. Pool 50 verlangt eine
# Cloud-SQL-Instanz mit max_connections >= ~100 (ab db-custom-2-7680; die
# Shared-Core-Stufen haben 25–50).
PUBSUB_FLOW_CONTROL_MAX_MESSAGES=500
DATABASE_POOL_MAX=50
DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000
REDIS_CONNECT_TIMEOUT_MS=5000

# Wie browse-and-buy-full-speed: kurze Deadline, damit die Abandon-Kohorte im
# Lauf ablaeuft und der Reaper sie zurueckverkauft; grosser Batch.
CHECKOUT_PENDING_TIMEOUT_SECONDS=60
WORKER_RESERVATION_REAPER_BATCH_SIZE=10000
WORKER_RESERVATION_REAPER_INTERVAL_SECONDS=60
WORKER_INVENTORY_CYCLE_INTERVAL_SECONDS=60
REDIS_FINAL_ORDER_TTL_SECONDS=86400
REDIS_WORKER_PROCESSED_TTL_SECONDS=86400

# 1M Tickets: bei den angenommenen 5 % Checkout-Anteil des 50k-Laufs
# ~2.200 Kaeufe/s -> Sellout nach ~7,5 min. 60 s Vorlauf zeigt 425 im Warm-up.
SEED_CAPACITY=1000000
SALE_OPENS_IN_SECONDS=60

VITE_API_URL=http://replace-me.invalid
VITE_EVENT_ID=00000000-0000-4000-8000-000000000000
