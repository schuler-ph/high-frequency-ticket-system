# Profil: bench — Hot-Row-Mikrobenchmark (pnpm bench:hot-row)
#
# Eigenes Profil, weil `bench-hot-row.mjs` sieben BENCH_*-Knoepfe hat, die in
# keinem Lasttest-Profil etwas zu suchen haetten. Kein Lasttest-Profil: das
# Werkzeug publiziert direkt an Pub/Sub und faehrt kein k6.

NODE_ENV=development
LOG_LEVEL=warn
DISABLE_REQUEST_LOGGING=false

REDIS_URL=redis://localhost:10004
DATABASE_URL=postgres://postgres:postgres@localhost:10006/high_frequency_tickets
GOOGLE_CLOUD_PROJECT=high-frequency-ticket-system
PUBSUB_EMULATOR_HOST=localhost:10005
PUBSUB_TOPIC_BUY_TICKET=buy-ticket
PUBSUB_SUBSCRIPTION_BUY_TICKET=buy-ticket-worker

PUBSUB_FLOW_CONTROL_MAX_MESSAGES=500
DATABASE_POOL_MAX=50
REDIS_CONNECT_TIMEOUT_MS=5000

CHECKOUT_PENDING_TIMEOUT_SECONDS=900
WORKER_RESERVATION_REAPER_BATCH_SIZE=1000
WORKER_INVENTORY_CYCLE_INTERVAL_SECONDS=60
REDIS_FINAL_ORDER_TTL_SECONDS=86400
REDIS_WORKER_PROCESSED_TTL_SECONDS=86400

SEED_CAPACITY=1000000
SALE_OPENS_IN_SECONDS=0

NEXT_PUBLIC_API_URL=http://localhost:10002
NEXT_PUBLIC_EVENT_ID=00000000-0000-4000-8000-000000000000

# --- Benchmark-Knoepfe ---
BENCH_EVENT_ID=00000000-0000-4000-8000-000000000000
BENCH_WORKER_METRICS_URL=http://localhost:10003/metrics
BENCH_MESSAGES=20000
BENCH_PUBLISH_BATCH=1000
BENCH_SAMPLE_INTERVAL_MS=100
BENCH_DRAIN_TIMEOUT_MS=300000
