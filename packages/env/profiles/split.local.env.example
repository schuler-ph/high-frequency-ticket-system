# Zwei-Maschinen-Lauf (RUNBOOK §4): Host-Topologie fuer den Split-Lauf.
# Als split.local.env kopieren und Werte eintragen — die Kopie ist
# gitignoriert, weil IPs, Nutzer und Pfade nicht ins Repo gehoeren.
# Der Task 'loadtest:run+report (split)' (Button 'Spike Split') sourced die
# Datei; die Werte stechen das Profil, weil gesetztes Prozess-Env vor
# Nodes --env-file gewinnt.

# ssh-Ziel auf dem Generator-PC (user@ip)
K6_SSH_HOST=<user>@10.0.0.2
# k6-REST-API auf dem Generator-PC (Sold-out-Stop; Firewall-Port freigeben)
K6_REST_URL=http://10.0.0.2:6565
# Repo-Klon auf dem Generator-PC, Pfad ohne Leerzeichen
K6_REMOTE_DIR=C:/hts
# SUT-Adresse aus Sicht des Generators (Mac-Seite des Direktlinks)
BASE_URL=http://10.0.0.1:10002
