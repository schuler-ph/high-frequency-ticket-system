# Profil: browse-and-buy-smoke — 1.000 Tickets, Verkauf sofort offen, jede
# Reservierung wird bezahlt: kein Unlock-Gate, kein Cancel, keine Denkzeit,
# kein Ablauf, kein Reaper-Eingriff. Auf, raus, fertig. Prueft, ob die
# Messkette RICHTIG ZAEHLT — ausdruecklich KEIN Kapazitaetsnachweis (Phase 5:
# Messkette lokal und in der Cloud abnehmen).
#
# Weil nichts abbricht, muss am Ende alles exakt 1.000 sein: reservations_
# created, orders_accepted, payments_confirmed, orders_completed, dbOrders,
# dbTickets, funnel_paid — und available 0, activeReservations 0, Drift 0,
# funnel_too_early 0. Jede Abweichung ist eine Doppel- oder Fehlzaehlung in
# der Messkette, kein Lastphaenomen. Danach nur noch 409 bis zum Stop, Order-
# Status-Polling, Drain. Der Sellout faellt in den Warm-up (20 it/s x 50 %
# Checkout = 10 Tickets/s → ~100 s); Laufzeit insgesamt ~3 Minuten.
#
# Die Lasttest-Profile wiederholen bewusst alle Werte, statt voneinander zu
# erben. Ein Lasttest-Profil muss auf einen Blick vollstaendig lesbar sein: was
# hier nicht steht, gilt nicht (ADR-034).

NODE_ENV=production
# Bei 50 it/s ist Request-Logging bezahlbar und fuer die Abnahme nuetzlich.
LOG_LEVEL=info
DISABLE_REQUEST_LOGGING=false

REDIS_URL=redis://localhost:10004
DATABASE_URL=postgres://postgres:postgres@localhost:10006/high_frequency_tickets
GOOGLE_CLOUD_PROJECT=high-frequency-ticket-system
PUBSUB_EMULATOR_HOST=localhost:10005
PUBSUB_TOPIC_BUY_TICKET=buy-ticket
PUBSUB_SUBSCRIPTION_BUY_TICKET=buy-ticket-worker

# Klein dimensioniert: ~18 Orders/s brauchen weder 500 Flow-Control-Slots noch
# 50 Pool-Connections; kleine Werte machen Saettigungs-Metriken glaubwuerdig.
PUBSUB_FLOW_CONTROL_MAX_MESSAGES=50
DATABASE_POOL_MAX=10
DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000
REDIS_CONNECT_TIMEOUT_MS=5000

# Lange Deadline: ohne Denkzeit zahlt jeder sofort, nichts darf ablaufen — der
# Reaper laeuft mit, hat aber nichts zu tun (reservation_reaper_releases_total
# muss 0 bleiben). Der COUNT(tickets)-Zyklus ist auf 15 s verkuerzt, damit
# Projector- und Auditor-Panels in einem 3-Minuten-Lauf mehr als drei Punkte
# zeigen (1.000 Zeilen kosten nichts).
CHECKOUT_PENDING_TIMEOUT_SECONDS=900
WORKER_RESERVATION_REAPER_BATCH_SIZE=100
WORKER_RESERVATION_REAPER_INTERVAL_SECONDS=15
WORKER_INVENTORY_CYCLE_INTERVAL_SECONDS=15
REDIS_FINAL_ORDER_TTL_SECONDS=86400
REDIS_WORKER_PROCESSED_TTL_SECONDS=86400

# 1.000 Tickets, Verkauf ab der ersten Anfrage offen (kein 425-Vorlauf).
SEED_CAPACITY=1000
SALE_OPENS_IN_SECONDS=0

# --- Lastgenerator (k6) ---
LOAD_PROFILE=browse-and-buy-smoke
# Wo k6 laeuft: local = dieser Host (co-located), ssh = Generator-PC. Fuer den
# Smoke-Lauf reicht co-located — er misst die Messkette, nicht die Maschine.
K6_RUNNER=local
BASE_URL=http://localhost:10002
EVENT_ID=00000000-0000-4000-8000-000000000000

# Lastform: 20 it/s Warm-up (Sale ist schon offen), Ramp auf 50 it/s, Sustain
# bis zum Sold-out — der meist schon im Warm-up erreicht ist. 200 VUs decken
# 50 it/s auch mit Status-Polling bequem.
K6_WARMUP_RATE=1000
K6_TARGET_RATE=1000
K6_MAX_VUS=200
K6_PREALLOCATED_VUS=20
K6_COOLDOWN_RATE=10
K6_COOLDOWN_MAX_VUS=20

# 50 % Checkout, 50 % Availability-Reads; jeder Checkout zahlt, niemand
# storniert, niemand laesst ablaufen — jeder Zaehler muss auf exakt 1.000 enden.
CHECKOUT_SHARE=1
PAY_RATE=1
CANCEL_RATE=0

# Keine Denkzeit: Reserve und Pay direkt hintereinander.
THINK_TIME_KIND=none
THINK_TIME_MIN=0
THINK_TIME_MAX=0
THINK_TIME_MEAN=0
THINK_TIME_SIGMA=0

# Polling an: uebt GET /orders/:orderId und dessen Metriken mit aus.
CHECKOUT_POLL=true
CHECKOUT_POLL_MAX_ATTEMPTS=10
CHECKOUT_POLL_INTERVAL=1

# --- Orchestrierung und Belegerhebung (scripts/local, scripts/load-test) ---
API_METRICS_URL=http://localhost:10002/metrics
WORKER_METRICS_URL=http://localhost:10003/metrics
PROMETHEUS_URL=http://localhost:10007
GRAFANA_URL=http://localhost:10008
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
GRAFANA_TZ=Europe/Vienna
EXPORT_GRAPHS=true

# Plateau-Erkennung: alle 3 s pollen, nach 3 stagnierenden Polls stoppen.
SPIKE_POLL_INTERVAL_MS=3000
SPIKE_SOLDOUT_CONFIRM_POLLS=3
SPIKE_GRACEFUL_STOP_TIMEOUT_MS=40000

# Prometheus-Remote-Write aus k6 heraus: standardmaessig aus, weil der Report
# seine Zahlen aus den Summaries und den Service-Metriken zieht.
K6_PROMETHEUS_RW=false
K6_PROMETHEUS_RW_SERVER_URL=http://localhost:10007/api/v1/write
