# Profil: cloud-dev — GKE, ruhig: Smoke-Test (Modul 7), Debugging, ein
# E2E-Kauf. Nicht fuer Messungen.
#
# Jede Variable steht hier explizit (ADR-034). Zwei Klassen kommen von aussen,
# und beides ist sichtbar statt implizit (ADR-040):
#   * Zugangsdaten stehen als LEERE Zuweisung (`REDIS_URL=`): der Key erfuellt
#     den Guard `debug:env`, der Wert kommt aus dem Kubernetes-Secret. Weil
#     `emptyStringAsUndefined` gesetzt ist, meldet Zod beim Boot "Required",
#     falls das Secret fehlt — Fail-Fast bleibt.
#   * Adressen, die erst nach `terraform apply` existieren, tragen `.invalid`
#     (RFC 2606, loest nie auf). Vor dem Deploy ersetzen — oder die externe IP
#     in Terraform reservieren (google_compute_global_address), dann ist sie
#     vorher bekannt.

NODE_ENV=production
LOG_LEVEL=info
DISABLE_REQUEST_LOGGING=false

# Zugangsdaten: aus dem Kubernetes-Secret, nie aus dem Repo (REQ-D06).
REDIS_URL=
DATABASE_URL=
# Projekt-ID ist kein Geheimnis, aber pro Umgebung verschieden. Ersetzen durch
# das eigene Projekt aus Modul 0 — nicht das gcloud-Default uebernehmen, ohne
# hinzusehen (`gcloud config get-value project`).
GOOGLE_CLOUD_PROJECT=replace-me-project-id
# Kein Emulator in der Cloud. Leer = ungesetzt; setzt voraus, dass die
# Schema-Variable optional ist (Aufgabe m1-t3), sonst bricht der Boot hier
# mit klarer Meldung ab — gewollt.
PUBSUB_EMULATOR_HOST=
# Muessen zu den Terraform-Ressourcen aus Modul 6 passen.
PUBSUB_TOPIC_BUY_TICKET=buy-ticket
PUBSUB_SUBSCRIPTION_BUY_TICKET=buy-ticket-worker

# Klein: ein Smoke-Test braucht keinen Durchsatz, und die kleinsten Cloud-SQL-
# Stufen haben wenige Verbindungen (db-f1-micro 25, db-g1-small 50).
PUBSUB_FLOW_CONTROL_MAX_MESSAGES=100
DATABASE_POOL_MAX=10
DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000
REDIS_CONNECT_TIMEOUT_MS=5000

# Menschliches Checkout-Fenster wie in dev.
CHECKOUT_PENDING_TIMEOUT_SECONDS=900
WORKER_RESERVATION_REAPER_BATCH_SIZE=1000
WORKER_RESERVATION_REAPER_INTERVAL_SECONDS=60
WORKER_INVENTORY_CYCLE_INTERVAL_SECONDS=60
REDIS_FINAL_ORDER_TTL_SECONDS=86400
REDIS_WORKER_PROCESSED_TTL_SECONDS=86400

# Kleiner Seed: fuer einen Kauf reichen 1.000 Tickets, und COUNT(tickets)
# bleibt billig.
SEED_CAPACITY=1000
SALE_OPENS_IN_SECONDS=0

