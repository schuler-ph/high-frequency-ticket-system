# VORLAGE — diese Datei wird von nichts geladen.
#
# Die tatsaechliche Konfiguration liegt in `config/env/<profil>.env` und wird
# ueber `HTS_ENV_PROFILE` ausgewaehlt. Es gibt bewusst keine `.env` mehr und
# keine Zod-Defaults: welcher Wert gilt, steht in genau einer Datei, und welche
# Datei gilt, steht in genau einer Variable (ADR-034).
#
#   HTS_ENV_PROFILE=dev pnpm dev
#   HTS_ENV_PROFILE=funnel pnpm spike:report
#
# Verfuegbare Profile: dev, test, ci, capacity, realism, checkout, funnel.
# Diese Datei dient nur als Referenz, welche Variablen ein Profil tragen muss;
# `pnpm run debug:env` prueft das maschinell.

# --- Von @repo/env validiert (packages/env/src/index.ts) ---
NODE_ENV=                                 # development | test | production
LOG_LEVEL=                                # fatal | error | warn | info | debug | trace
DISABLE_REQUEST_LOGGING=                  # true | false
REDIS_URL=
DATABASE_URL=
GOOGLE_CLOUD_PROJECT=
PUBSUB_EMULATOR_HOST=
PUBSUB_TOPIC_BUY_TICKET=
PUBSUB_SUBSCRIPTION_BUY_TICKET=
PUBSUB_FLOW_CONTROL_MAX_MESSAGES=
DATABASE_POOL_MAX=
REDIS_CONNECT_TIMEOUT_MS=
CHECKOUT_PENDING_TIMEOUT_SECONDS=
WORKER_RESERVATION_REAPER_BATCH_SIZE=
WORKER_INVENTORY_CYCLE_INTERVAL_SECONDS=
REDIS_FINAL_ORDER_TTL_SECONDS=
REDIS_WORKER_PROCESSED_TTL_SECONDS=

# --- Seed/Reset (scripts/local/reset.mjs) ---
SEED_CAPACITY=
SALE_OPENS_IN_SECONDS=

# --- Frontend (Next.js inlined NEXT_PUBLIC_* zur Build-Zeit) ---
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_EVENT_ID=

# --- Nur in den Lasttest-Profilen (k6, load-tests/lib/scenario-helpers.js) ---
LOAD_PROFILE=                             # capacity | realism | checkout | funnel
BASE_URL=
EVENT_ID=
CHECKOUT_SHARE=
PAY_RATE=
CANCEL_RATE=
THINK_TIME_KIND=                          # none | uniform | normal
THINK_TIME_MIN=
THINK_TIME_MAX=
THINK_TIME_MEAN=
THINK_TIME_SIGMA=
CHECKOUT_POLL=
CHECKOUT_POLL_MAX_ATTEMPTS=
CHECKOUT_POLL_INTERVAL=
